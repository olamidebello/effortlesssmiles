# Managed only by Effortless Smiles deployment. Olamidepanel keeps its own port.
server {
    listen 80;
    listen [::]:80;
    server_name {{ es_domain }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/effortlesssmiles-acme; }
    location = /.es-deploy-check { default_type text/plain; return 200 'effortlesssmiles:{{ es_domain }}'; }
{% if es_tls_ready %}
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ es_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ es_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ es_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location = /.es-deploy-check { default_type text/plain; return 200 'effortlesssmiles:{{ es_domain }}'; }
{% endif %}
    client_max_body_size 2m;
    location / {
        if (-f /run/effortlesssmiles-maintenance) { return 503; }
        proxy_pass http://127.0.0.1:{{ es_selected_port }};
        proxy_http_version 1.1;
        proxy_set_header Host {{ es_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host {{ es_domain }};
        proxy_set_header oai-authenticated-user-id "";
        proxy_set_header oai-authenticated-user-email "";
        proxy_set_header oai-authenticated-user-full-name "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
